# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA faça commit do .env.local (ele já está no .gitignore).

# ---------- Firebase (navegador) ----------
# Firebase Console > Configurações do projeto (engrenagem) > Geral > "Seus apps" > Configuração do SDK.
# Estes valores são públicos por natureza (vão para o navegador).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Login com Google ----------
# Client ID do tipo "Aplicativo da Web" criado no Google Cloud Console
# (APIs e serviços > Credenciais). Termina em ".apps.googleusercontent.com".
# Não é segredo: o botão do Google precisa dele no navegador, e o servidor usa o mesmo
# valor para conferir que o token foi emitido para o SEU jogo.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---------- Firebase Admin (só servidor — SEGREDO) ----------
# Firebase Console > Configurações do projeto > Contas de serviço > "Gerar nova chave privada".
# Abre um arquivo .json; copie destes campos:
#   "project_id"   -> FIREBASE_ADMIN_PROJECT_ID
#   "client_email" -> FIREBASE_ADMIN_CLIENT_EMAIL
#   "private_key"  -> FIREBASE_ADMIN_PRIVATE_KEY (entre aspas duplas, exatamente como está no .json, com os \n)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Sessão (só servidor — SEGREDO) ----------
# Texto aleatório com pelo menos 32 caracteres, usado para assinar o cookie de login.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Se trocar este valor, todos os jogadores são deslogados.
SESSION_SECRET=
