{
  "rules": {
    ".read": false,
    ".write": false,
    "bisca": {
      "rooms": {
        "$code": {
          ".read": "$code.matches(/^[A-HJ-NP-Z]{4}$/)",
          ".write": "$code.matches(/^[A-HJ-NP-Z]{4}$/)",
          "game": {
            ".validate": "!newData.exists() || newData.val() === null || newData.hasChild('phase')"
          },
          "chat": {
            ".validate": "!newData.exists() || newData.val() === null || !newData.hasChildren() || !newData.child('120').exists()"
          },
          "reconnectGrace": {
            "$playerId": {
              ".validate": "!newData.exists() || newData.isNumber()"
            }
          },
          "lastPing": {
            "$playerId": {
              ".validate": "!newData.exists() || newData.isNumber()"
            }
          }
        }
      },
      "presence": {
        "$code": {
          ".read": "$code.matches(/^[A-HJ-NP-Z]{4}$/)",
          ".write": "$code.matches(/^[A-HJ-NP-Z]{4}$/) && !newData.exists()",
          "$playerId": {
            ".write": "$code.matches(/^[A-HJ-NP-Z]{4}$/) && $playerId.matches(/^[a-zA-Z0-9_:.-]{2,80}$/) && (!$playerId.beginsWith('g_') || (auth != null && auth.uid === $playerId))",
            ".validate": "!newData.exists() || newData.val() === true"
          }
        }
      },
      "users": {
        ".read": false,
        ".write": false
      }
    }
  }
}
